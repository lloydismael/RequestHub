# Django / Request Hub local environment
# Copy this file to .env and fill in local/runtime values.
# Never commit .env. Never store application login usernames or passwords here.

# Django
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Canonical production domain. Comma-separated; each entry is added to
# ALLOWED_HOSTS and CSRF_TRUSTED_ORIGINS. Production: esgrequesthub.com
DJANGO_PRIMARY_DOMAIN=esgrequesthub.com
# Absolute base URL for outbound email links; never derived from the incoming host.
DJANGO_PUBLIC_BASE_URL=https://esgrequesthub.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://esgrequesthub.com
DJANGO_SERVE_MEDIA=false
DJANGO_MEDIA_ROOT=
DJANGO_MEDIA_URL=media/
DJANGO_DEFAULT_FROM_EMAIL=ESG Request Hub <no-reply@esgrequesthub.com>

# PostgreSQL
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_SSLMODE=require

# Azure Communication Services email
# Production sender (verified on esgrequesthub.com): DoNotReply@esgrequesthub.com
# Leave empty in this template per secret-hygiene policy; set real value in .env / App Settings.
ACS_EMAIL_CONNECTION_STRING=
ACS_EMAIL_SENDER=

# Native assistant provider (disabled until deployment details and consent are ready).
AI_ASSISTANT_NATIVE_ENABLED=false
AZURE_AI_BASE_URL=
AZURE_AI_DEPLOYMENT=
AZURE_AI_AUTH_MODE=managed_identity
# Set the audience documented for this exact Foundry endpoint.
AZURE_AI_TOKEN_SCOPE=
# Needed only when AZURE_AI_AUTH_MODE=api_key; keep the value in secret storage.
AZURE_AI_API_KEY=

# Legacy Microsoft Graph application integration (not used by delegated SQR drafts).
# The user-authorized SQR Outlook integration below uses a separate app registration.
PHILDATA_TENANT_ID=
PHILDATA_CLIENT_ID=
PHILDATA_CLIENT_SECRET=
PHILDATA_DOMAIN=phildata.com
PHILDATA_GRAPH_SCOPE=https://graph.microsoft.com/.default

# Do not add application permissions to the separate delegated SQR registration.

# User-authorized Microsoft 365 SQR drafts: separate confidential Web app.
# Delegated permission ONLY: Mail.ReadWrite. No Mail.Send/application permission.
# Register the exact callback URI below; HTTPS required except DEBUG localhost.
SQR_OUTLOOK_TENANT_ID=
SQR_OUTLOOK_CLIENT_ID=
# Client secret, or a PFX certificate below. Use the certificate when secrets are blocked by tenant policy.
SQR_OUTLOOK_CLIENT_SECRET=
# PFX exported from the certificate uploaded to the app registration. Keep it out of git and the image.
SQR_OUTLOOK_CERT_PATH=
SQR_OUTLOOK_CERT_PASSWORD=
SQR_OUTLOOK_REDIRECT_URI=https://esgrequesthub.com/sqr/outlook/callback/
# Persistent deployment Fernet key, separate from DJANGO_SECRET_KEY. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep in secret storage; changing it invalidates saved Microsoft connections.
SQR_OUTLOOK_TOKEN_KEY=
# Use server-side Django sessions; signed-cookie sessions are not supported.
